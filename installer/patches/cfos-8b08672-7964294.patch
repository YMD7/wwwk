+function parseLinkedSourceHandle(handle: string): {overseerId: string; nonce: string} | null {
+  const match = /^cfosls1_([0-9a-f]+)_([0-9a-f-]{36})$/i.exec(handle);
+  return match ? {overseerId: match[1], nonce: match[2]} : null;
+}
+
+function parseSourceAccessId(sourceAccessId: string): {overseerId: string; nonce: string} | null {
+  const match = /^cfoslsa1_([0-9a-f]+)_([0-9a-f-]{36})$/i.exec(sourceAccessId);
+  return match ? {overseerId: match[1], nonce: match[2]} : null;
