+    if (!parsed) return null;
+    try {
+      const ns = this.ctx.exports.OverseerDurableObject;
+      return await ns.get(ns.idFromString(parsed.overseerId))
+        .describeLinkedSourceHandle(parsed.nonce);
+    } catch {
+      return null;
+    }
