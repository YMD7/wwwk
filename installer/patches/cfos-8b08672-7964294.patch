+import { describe, expect, it, vi } from "vitest";
+import { env } from "cloudflare:workers";
+import { runInDurableObject } from "cloudflare:test";
+import {
+  LinkedSourceApprovalQueueImpl,
+  SourceAccessBroker,
+  linkedSourceHandlePropsForCaller,
+} from "../src/overseer.js";
+import type { OverseerDurableObject } from "../src/overseer.js";
+
+declare module "cloudflare:workers" {
+  interface ProvidedEnv {
+    TEST_OVERSEER: DurableObjectNamespace<OverseerDurableObject>;
+  }
+}
+
+const handle = "cfosls1_abcdef_11111111-1111-4111-8111-111111111111";
+
+function makeBroker(overseer: {
+  describeLinkedSourceHandle: (nonce: string) => Promise<object | null>;
+  openLinkedSourceHandle: (nonce: string) => Promise<object | null>;
+  registerSourceAccessHandle: (nonce: string) => string | null;
+}): SourceAccessBroker {
+  const broker = Object.create(SourceAccessBroker.prototype) as SourceAccessBroker;
+  Object.assign(broker, {ctx: {exports: {OverseerDurableObject: {
+    idFromString: (id: string) => id,
+    get: () => overseer,
+  }}}});
+  return broker;
+}
+
+describe("Linked Source handles", () => {
+  it("issues handles only to an agent for a gatekeeper binding", () => {
+    expect(linkedSourceHandlePropsForCaller(
+        {from: "agent", chatId: 4}, {type: "gatekeeper", id: 7}, "overseer-id"))
+      .toEqual({overseerId: "overseer-id", gatekeeperId: 7});
+    expect(() => linkedSourceHandlePropsForCaller(
+        {from: "gadget", gadgetId: 2}, {type: "gatekeeper", id: 7}, "overseer-id"))
+      .toThrow("Linked Source handles");
+  });
+
+  it("resolves a registered handle, opens fresh sessions, and rejects revocation", async () => {
+    const nonce = "11111111-1111-4111-8111-111111111111";
+    const registrations = new Map<string, {vendorId: string}>([
+      [nonce, {vendorId: "notion"}],
+    ]);
+    const first = {session: 1};
+    const second = {session: 2};
+    const describeLinkedSourceHandle = vi.fn(async (registeredNonce: string) =>
+      registrations.get(registeredNonce) ?? null,
+    );
+    const openLinkedSourceHandle = vi.fn(async (registeredNonce: string) => {
+      if (!registrations.has(registeredNonce)) return null;
+      return openLinkedSourceHandle.mock.calls.length === 1 ? first : second;
+    });
+    const registerSourceAccessHandle = vi.fn((registeredNonce: string) =>
+      registrations.has(registeredNonce)
+        ? "cfoslsa1_abcdef_22222222-2222-4222-8222-222222222222"
+        : null,
+    );
+    const broker = makeBroker({
+      describeLinkedSourceHandle,
+      openLinkedSourceHandle,
+      registerSourceAccessHandle,
+    });
+
+    await expect(broker.describe(handle)).resolves.toEqual({vendorId: "notion"});
+    await expect(broker.openReadSession(handle)).resolves.toBe(first);
+    await expect(broker.openReadSession(handle)).resolves.toBe(second);
+    await expect(broker.registerSourceAccess(handle)).resolves.toBe(
+      "cfoslsa1_abcdef_22222222-2222-4222-8222-222222222222",
+    );
+    expect(describeLinkedSourceHandle).toHaveBeenCalledWith(nonce);
+    expect(openLinkedSourceHandle).toHaveBeenCalledTimes(2);
+    expect(openLinkedSourceHandle).toHaveBeenNthCalledWith(1, nonce);
+    expect(openLinkedSourceHandle).toHaveBeenNthCalledWith(2, nonce);
+    expect(registerSourceAccessHandle).toHaveBeenCalledWith(nonce);
+
+    registrations.delete(nonce);
+    await expect(broker.describe(handle)).resolves.toBeNull();
+    await expect(broker.openReadSession(handle)).resolves.toBeNull();
+    await expect(broker.registerSourceAccess(handle)).resolves.toBeNull();
+  });
+
+  it("authorizes observations as linked-source and rejects actions and hooks", async () => {
+    const authorizeObservation = vi.fn(async () => {});
+    const queue = new LinkedSourceApprovalQueueImpl({authorizeObservation}, 7);
+    await queue.authorizeObservation({title: "Read source", description: "Read source."});
+    expect(authorizeObservation).toHaveBeenCalledWith(
+      7, {title: "Read source", description: "Read source."}, {from: "linked-source"},
+    );
+    expect(() => queue.submitAction(1, {title: "Write", description: "Write."}))
+      .toThrow("observation-only");
+    expect(() => queue.bindHook(
+      undefined!, undefined!, {title: "Hook", description: "Hook."},
+    )).toThrow("observation-only");
+  });
+});
+
+type TestOverseer = {
+  impl: {
+    ctx: DurableObjectState;
+    storage: any;
+    getGatekeeperFacet(id: number): any;
+    listObserverRequirements(role: "build" | "use"): Promise<unknown[]>;
+    ensureObserver(
+      profileId: string,
+      clientUser: object,
+      role: "build" | "use",
+      configureCb?: object,
+    ): Promise<void>;
+    authorizeSourceObservation(
+      gatekeeperId: number,
+      description: {title: string; description: string},
+      sourceAccessIds: string[],
+      caller: object,
+    ): Promise<void>;
+  };
+};
+
+function sourceAccessId(impl: TestOverseer["impl"], nonce: string): string {
+  return `cfoslsa1_${impl.ctx.id.toString()}_${nonce}`;
+}
+
+function gatekeeperRecord(
+    id: number,
+    vendorId: string,
+    hasObservedSourceAccessIds = false): object {
+  return {
+    id,
+    class: {},
+    creationSpec: {
+      type: "gatekeeper",
+      vendorId,
+      resourceUrl: `https://${vendorId}.invalid/resource`,
+      typeUrlPattern: "https://*.invalid/*",
+    },
+    hasObservedSourceAccessIds,
+  };
+}
+
+function ambientWwwkRecord(id: number, hasObservedSourceAccessIds?: boolean): object {
+  return {
+    id,
+    class: {},
+    creationSpec: {type: "ambient", vendorId: "wwwk", accountId: 1},
+    ...(hasObservedSourceAccessIds === undefined ? {} : {hasObservedSourceAccessIds}),
+  };
+}
+
+async function inTestOverseer(
+    name: string,
+    callback: (impl: TestOverseer["impl"]) => Promise<void>): Promise<void> {
+  const stub = env.TEST_OVERSEER.getByName(name);
+  await runInDurableObject(stub, async (instance: OverseerDurableObject) => {
+    await callback((instance as unknown as TestOverseer).impl);
+  });
+}
+
+describe("Linked Source observer requirements", () => {
+  it("applies an unbound ambient WWWK source requirement to a use collaborator", async () => {
+    await inTestOverseer("wwwk-unbound-use-observer", async impl => {
+      const sourceId = 21;
+      const wwwkId = 22;
+      const nonce = "11111111-1111-4111-8111-111111111111";
+      const accessId = sourceAccessId(impl, nonce);
+      impl.ctx.storage.kv.put(`sourceAccessId:${nonce}`, sourceId);
+      impl.storage.gatekeepers.put(gatekeeperRecord(sourceId, "notion"));
+      impl.storage.gatekeepers.put(ambientWwwkRecord(wwwkId, true));
+      const addObserver = vi.fn(async () => {});
+      impl.getGatekeeperFacet = (id: number) => {
+        if (id === sourceId) return {addObserver};
+        if (id === wwwkId) {
+          return {listObservedSourceAccessIds: async () => [accessId]};
+        }
+        throw new Error(`Unexpected gatekeeper ${id}.`);
+      };
+
+      const configure = vi.fn(async () => [{gatekeeperId: sourceId, accountId: 1}]);
+      await impl.ensureObserver("collaborator", {
+        listProvidedAccounts: async () => [],
+        getVerifier: async () => ({}),
+      }, "use", {configure} as object);
+
+      expect(configure).toHaveBeenCalledWith([
+        expect.objectContaining({gatekeeperId: sourceId, vendorId: "notion"}),
+      ]);
+      expect(addObserver).toHaveBeenCalledTimes(1);
+    });
+  });
+
+  it("lazily backfills an existing ambient WWWK record before reading requirements", async () => {
+    await inTestOverseer("wwwk-legacy-observer-record", async impl => {
+      const sourceId = 31;
+      const wwwkId = 32;
+      const nonce = "22222222-2222-4222-8222-222222222222";
+      const accessId = sourceAccessId(impl, nonce);
+      impl.ctx.storage.kv.put(`sourceAccessId:${nonce}`, sourceId);
+      impl.storage.gatekeepers.put(gatekeeperRecord(sourceId, "notion"));
+      impl.storage.gatekeepers.put(ambientWwwkRecord(wwwkId));
+      impl.getGatekeeperFacet = (id: number) => {
+        if (id === wwwkId) {
+          return {
+            describe: async () => ({hasObservedSourceAccessIds: true}),
+            listObservedSourceAccessIds: async () => [accessId],
+          };
+        }
+        throw new Error(`Unexpected gatekeeper ${id}.`);
+      };
+
+      await expect(impl.listObserverRequirements("use")).resolves.toEqual([
+        expect.objectContaining({gatekeeperId: sourceId, vendorId: "notion"}),
+      ]);
+      expect(impl.storage.gatekeepers.get(wwwkId)?.hasObservedSourceAccessIds).toBe(true);
+    });
+  });
+
+  it("rechecks a new observer when a Source requirement arrives during admission", async () => {
+    await inTestOverseer("wwwk-observer-recheck", async impl => {
+      const emailId = 41;
+      const sourceId = 42;
+      const wwwkId = 43;
+      const nonce = "33333333-3333-4333-8333-333333333333";
+      const accessId = sourceAccessId(impl, nonce);
+      impl.ctx.storage.kv.put(`sourceAccessId:${nonce}`, sourceId);
+      impl.storage.gatekeepers.put(gatekeeperRecord(emailId, "email"));
+      impl.storage.gatekeepers.put(gatekeeperRecord(sourceId, "notion"));
+      impl.storage.gatekeepers.put(ambientWwwkRecord(wwwkId, true));
+      impl.storage.gadgets.put({
+        id: 1,
+        title: "Test gadget",
+        created: new Date(),
+        bindingName: "GADGET",
+        bindings: {EMAIL: {target: emailId}},
+      });
+
+      const emailAddObserver = vi.fn(async () => {});
+      const sourceAddObserver = vi.fn(async () => {});
+      impl.getGatekeeperFacet = (id: number) => {
+        if (id === emailId) return {addObserver: emailAddObserver};
+        if (id === sourceId) return {addObserver: sourceAddObserver};
+        if (id === wwwkId) return {listObservedSourceAccessIds: async () => []};
+        throw new Error(`Unexpected gatekeeper ${id}.`);
+      };
+
+      let releaseEmailVerifier: (() => void) | undefined;
+      const emailVerifier = new Promise<object>(resolve => {
+        releaseEmailVerifier = () => resolve({});
+      });
+      const getVerifier = vi.fn((accountId: number, vendorId: string) => {
+        if (accountId === 1 && vendorId === "email") return emailVerifier;
+        return Promise.resolve({});
+      });
+      const configure = vi.fn(async (needs: Array<{gatekeeperId: number; vendorId: string}>) =>
+        needs.map(need => ({
+          gatekeeperId: need.gatekeeperId,
+          accountId: need.vendorId === "email" ? 1 : 2,
+        })),
+      );
+      const clientUser = {
+        listProvidedAccounts: async () => [],
+        getVerifier,
+      };
+
+      const admission = impl.ensureObserver(
+        "collaborator", clientUser, "use", {configure} as object,
+      );
+      await vi.waitFor(() => {
+        expect(getVerifier).toHaveBeenCalledWith(1, "email");
+      });
+
+      await impl.authorizeSourceObservation(
+        wwwkId,
+        {title: "Read WWWK", description: "Read a linked source."},
+        [accessId],
+        {from: "agent", chatId: 1},
+      );
+      releaseEmailVerifier?.();
+      await admission;
+
+      expect(configure).toHaveBeenNthCalledWith(1, [
+        expect.objectContaining({gatekeeperId: emailId, vendorId: "email"}),
+      ]);
+      expect(configure).toHaveBeenNthCalledWith(2, [
+        expect.objectContaining({gatekeeperId: sourceId, vendorId: "notion"}),
+      ]);
+      expect(sourceAddObserver).toHaveBeenCalledTimes(1);
+      expect(impl.storage.observers.get("collaborator")?.accountChoices).toMatchObject({
+        [emailId]: 1,
+        [sourceId]: 2,
+      });
+    });
+  });
+});
