--- /dev/null
+++ b/packages/workshop-backend/__tests__/provisioning-policy.test.ts
@@ -0,0 +1,35 @@
+import { describe, expect, it } from "vitest";
+import { DEFAULT_ADMIN_CONFIG } from "../src/admin-config.js";
+import { shouldSurfaceAutoProvisionedAccount } from "../src/provisioning-policy.js";
+
+describe("shouldSurfaceAutoProvisionedAccount", () => {
+  it("keeps an account dormant while its vendor binding is absent", () => {
+    let config = {
+      ...DEFAULT_ADMIN_CONFIG,
+      ambientGatekeeperModes: { wwwk: "enabled" as const },
+    };
+
+    expect(shouldSurfaceAutoProvisionedAccount(config, "wwwk", false)).toBe(false);
+  });
+
+  it.each(["optional", "enabled"] as const)(
+    "surfaces a bound account in %s mode",
+    (mode) => {
+      let config = {
+        ...DEFAULT_ADMIN_CONFIG,
+        ambientGatekeeperModes: { wwwk: mode },
+      };
+
+      expect(shouldSurfaceAutoProvisionedAccount(config, "wwwk", true)).toBe(true);
+    },
+  );
+
+  it("keeps an administratively disabled account dormant", () => {
+    let config = {
+      ...DEFAULT_ADMIN_CONFIG,
+      ambientGatekeeperModes: { wwwk: "disabled" as const },
+    };
+
+    expect(shouldSurfaceAutoProvisionedAccount(config, "wwwk", true)).toBe(false);
+  });
+});
diff --git a/packages/workshop-backend/src/provisioning-policy.ts b/packages/workshop-backend/src/provisioning-policy.ts
--- a/packages/workshop-backend/src/provisioning-policy.ts
+++ b/packages/workshop-backend/src/provisioning-policy.ts
@@ -28,3 +28,10 @@ export function shouldAutoProvisionAccount(config: AdminConfig, vendorId: string
 export function shouldAutoProvisionAccount(config: AdminConfig, vendorId: string): boolean {
   return ambientGatekeeperMode(config, vendorId) === "enabled";
 }
+
+// Stored ambient account capabilities outlive service-binding changes. Keep the account dormant
+// while its vendor is unbound so disconnect removes agent and UI access without deleting data.
+export function shouldSurfaceAutoProvisionedAccount(
+    config: AdminConfig, vendorId: string, vendorBound: boolean): boolean {
+  return vendorBound && ambientGatekeeperMode(config, vendorId) !== "disabled";
+}
