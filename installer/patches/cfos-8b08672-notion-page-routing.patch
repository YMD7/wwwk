@@ -1,0 +2,4 @@ import { describe, expect, it } from "vitest";
+import {
+  resolveRequestedResource,
+  type SupportedResource,
+} from "@gadgets/workshop-shared/gatekeeper";
@@ -3,0 +8 @@ import {
+  classifyNotionResourceUrl,
@@ -4,0 +10 @@ import {
+  NOTION_ITEM_URL_PATTERN,
@@ -65,0 +72,46 @@ describe("parseNotionId", () => {
+describe("Notion resource routing", () => {
+  const itemId = "8513f007-d607-4da8-8eeb-abcbcd0b78f4";
+  const resources: SupportedResource[] = [{
+    urlPattern: "https://*",
+    title: "Notion Workspace",
+    description: "Whole workspace",
+  }, {
+    urlPattern: NOTION_ITEM_URL_PATTERN,
+    title: "Notion Page or Database",
+    description: "Specific item",
+  }];
+
+  it("routes both current Notion page URL forms to one item", () => {
+    expect(classifyNotionResourceUrl(
+      "https://www.notion.so/Team-Home-8513f007d6074da88eebabcbcd0b78f4",
+    )).toEqual({ kind: "item", itemId });
+    expect(classifyNotionResourceUrl(
+      "https://app.notion.com/p/Team-Home-8513f007d6074da88eebabcbcd0b78f4",
+    )).toEqual({ kind: "item", itemId });
+
+    const pattern = new URLPattern(NOTION_ITEM_URL_PATTERN);
+    expect(pattern.test("https://www.notion.so/8513f007d6074da88eebabcbcd0b78f4")).toBe(true);
+    expect(pattern.test("https://app.notion.com/p/8513f007d6074da88eebabcbcd0b78f4")).toBe(true);
+    expect(resolveRequestedResource(
+      resources,
+      "https://app.notion.com/p/8513f007d6074da88eebabcbcd0b78f4",
+    )).toMatchObject({ ok: true, resource: { title: "Notion Page or Database" } });
+  });
+
+  it("routes only an explicit Notion root to the workspace", () => {
+    expect(classifyNotionResourceUrl("https://www.notion.so/")).toEqual({ kind: "workspace" });
+    expect(() => classifyNotionResourceUrl("https://example.invalid/page"))
+      .toThrow("Unsupported Notion resource URL");
+    expect(() => classifyNotionResourceUrl("https://app.notion.com/p/not-a-page"))
+      .toThrow("Could not find a Notion ID");
+    expect(() => classifyNotionResourceUrl("http://www.notion.so/"))
+      .toThrow("Unsupported Notion resource URL");
+    expect(() => classifyNotionResourceUrl("https://team.notion.so/"))
+      .toThrow("Unsupported Notion resource URL");
+    expect(resolveRequestedResource(resources, "https://example.invalid/page"))
+      .toMatchObject({ ok: false });
+    expect(resolveRequestedResource(resources, undefined))
+      .toMatchObject({ ok: true, resource: { title: "Notion Workspace" } });
+  });
+});
+
diff --git a/packages/gatekeeper-notion/src/notion-api.ts b/packages/gatekeeper-notion/src/notion-api.ts
index 5cdb57a..3f4090b 100644
--- a/packages/gatekeeper-notion/src/notion-api.ts
+++ b/packages/gatekeeper-notion/src/notion-api.ts
@@ -659,0 +660,30 @@ export function primaryDataSourceId(db: NotionDatabaseResponse): string {
+export const NOTION_ITEM_URL_PATTERN =
+  "https://:host(www\\.notion\\.so|app\\.notion\\.com)/:path+";
+
+export type NotionResourceTarget =
+  | { kind: "item"; itemId: string }
+  | { kind: "workspace" };
+
+// Classify only explicit Notion resource URLs. An unrecognized item URL must not widen into the
+// whole-workspace capability.
+export function classifyNotionResourceUrl(resourceUrl: string): NotionResourceTarget {
+  let parsed: URL;
+  try {
+    parsed = new URL(resourceUrl);
+  } catch {
+    throw new NotionApiError(400, "Invalid Notion resource URL.");
+  }
+
+  if (parsed.protocol !== "https:") {
+    throw new NotionApiError(400, "Unsupported Notion resource URL.");
+  }
+  const hostname = parsed.hostname.toLowerCase();
+  const isNotionHost = hostname === "www.notion.so" || hostname === "app.notion.com";
+  if (!isNotionHost) {
+    throw new NotionApiError(400, "Unsupported Notion resource URL.");
+  }
+
+  if (parsed.pathname.replace(/\/+$/, "") === "") return { kind: "workspace" };
+  return { kind: "item", itemId: parseNotionId(resourceUrl) };
+}
+
