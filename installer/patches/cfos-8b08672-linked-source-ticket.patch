+describe("Linked Source ticket storage", () => {
+  it("keeps one short-lived ticket per gatekeeper and consumes it atomically", async () => {
+    await inTestOverseer("linked-source-ticket", async impl => {
+      const gatekeeperId = 31;
+      impl.storage.gatekeepers.put(gatekeeperRecord(gatekeeperId, "notion"));
+      impl.ctx.storage.kv.put(
+        `linkedSourceHandleForGatekeeper:${gatekeeperId}`,
+        "44444444-4444-4444-8444-444444444444",
+      );
+      impl.ctx.storage.kv.put(
+        "linkedSourceHandle:44444444-4444-4444-8444-444444444444",
+        gatekeeperId,
+      );
+
+      const first = impl.createLinkedSourceTicket(gatekeeperId);
+      const second = impl.createLinkedSourceTicket(gatekeeperId);
+      const firstNonce = first.split("_").at(-1)!;
+      const secondNonce = second.split("_").at(-1)!;
+      expect(first).toMatch(/^cfoslst1_/);
+      expect(second).not.toBe(first);
+      expect(impl.claimLinkedSourceTicket(firstNonce, Date.now())).toBeNull();
+
+      const claimed = impl.claimLinkedSourceTicket(secondNonce, Date.now());
+      expect(claimed).toEqual({
+        sourceHandle: expect.stringMatching(/^cfoslsi1_/),
+        sourceAccessId: expect.stringMatching(/^cfoslsa1_/),
+      });
+      expect(impl.claimLinkedSourceTicket(secondNonce, Date.now())).toBeNull();
+      expect(impl.ctx.storage.kv.get(
+        `linkedSourceHandleForGatekeeper:${gatekeeperId}`,
+      )).toBeUndefined();
+      expect(impl.ctx.storage.kv.get(
+        "linkedSourceHandle:44444444-4444-4444-8444-444444444444",
+      )).toBeUndefined();
+
+      const expired = impl.createLinkedSourceTicket(gatekeeperId);
+      expect(impl.claimLinkedSourceTicket(
+        expired.split("_").at(-1)!,
+        Number.MAX_SAFE_INTEGER,
+      )).toBeNull();
+    });
+  });
+});
+
